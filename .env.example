# Copiar a .env.local para desarrollo (`next dev`) y a .dev.vars para `npm run preview`.
# En producción se cargan con: npx wrangler secret put NOMBRE

# Clave de Resend. Sin ella, el formulario ofrece solo la salida por WhatsApp.
RESEND_API_KEY=

# Remitente verificado en Resend. Ejemplo: "FluxWeb <hola@tudominio.com>"
CONTACT_FROM_EMAIL=

# A dónde llegan las consultas. Si falta, van a fluxwebpages@gmail.com
CONTACT_TO_EMAIL=

# URL pública del sitio (se lee en el build: canónica, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=

# Token de Cloudflare Web Analytics (opcional, sin cookies).
NEXT_PUBLIC_CF_BEACON_TOKEN=
